<form version="1.1" theme="dark">
  <label>Homelab capacity signals</label>
  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="time" searchWhenChanged="true">
      <label>Time range</label>
      <default>
        <earliest>-24h</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="text" token="host" searchWhenChanged="true">
      <label>Host</label>
      <default>*</default>
    </input>
    <input type="text" token="pool" searchWhenChanged="true">
      <label>Pool</label>
      <default>*</default>
    </input>
  </fieldset>
  <row>
    <panel>
      <chart>
        <title>Object-store filesystem used %</title>
        <search>
          <query>| mstats latest(node_filesystem_avail_bytes) AS available latest(node_filesystem_size_bytes) AS total WHERE index=host_metrics mountpoint="/srv/object-storage" host="$host$" span=5m BY host | eval used_pct=round((1-available/total)*100,1) | timechart max(used_pct) by host limit=10</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
        <title>ZFS pool capacity %</title>
        <search>
          <query>| mstats latest(pve_zpool_cap_percent) AS used_pct WHERE index=host_metrics host="$host$" pool="$pool$" span=5m BY host pool | timechart max(used_pct) by pool limit=10</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
      </chart>
    </panel>
  </row>
</form>
