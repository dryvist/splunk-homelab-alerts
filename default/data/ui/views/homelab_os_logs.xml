<form version="1.1" theme="dark">
  <label>Homelab OS log signals</label>
  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="time" searchWhenChanged="true">
      <label>Time range</label>
      <default>
        <earliest>-24h</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="dropdown" token="index" searchWhenChanged="true">
      <label>Index</label>
      <choice value="*">All</choice>
      <choice value="os">os</choice>
      <choice value="os_ai">os_ai</choice>
      <choice value="os_proxmox">os_proxmox</choice>
      <default>*</default>
    </input>
    <input type="text" token="host" searchWhenChanged="true">
      <label>Host</label>
      <default>*</default>
    </input>
  </fieldset>
  <row>
    <panel>
      <chart>
        <title>OS log events by host</title>
        <search>
          <query>index=$index$ host="$host$" | timechart span=5m count by host limit=10</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
        <title>Proxmox I/O pressure (psi_io_avg60)</title>
        <search>
          <query>index=os_proxmox sourcetype=pve:health host="$host$" | rex field=_raw "psi_io_avg60=(?&lt;psi_io_avg60&gt;[\d.]+)" | timechart span=1m max(psi_io_avg60) by host limit=10</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
      </chart>
    </panel>
  </row>
</form>
