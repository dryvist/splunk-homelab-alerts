<form version="1.1" theme="dark">
  <label>Homelab Ansible signals</label>
  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="time" searchWhenChanged="true">
      <label>Time range</label>
      <default>
        <earliest>-24h</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="text" token="host" searchWhenChanged="true">
      <label>Host</label>
      <default>*</default>
    </input>
    <input type="dropdown" token="sourcetype" searchWhenChanged="true">
      <label>Sourcetype</label>
      <choice value="*">All</choice>
      <choice value="ansible:converge:unreachable">ansible:converge:unreachable</choice>
      <choice value="nautobot:drift">nautobot:drift</choice>
      <default>*</default>
    </input>
  </fieldset>
  <row>
    <panel>
      <chart>
        <title>Ansible index events by sourcetype</title>
        <search>
          <query>index=ansible host="$host$" sourcetype="$sourcetype$" | timechart span=30m count by sourcetype limit=10</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
        <title>Converge unreachable events by host</title>
        <search>
          <query>index=ansible sourcetype="ansible:converge:unreachable" host="$host$" | timechart span=30m count by host limit=10</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
      </chart>
    </panel>
  </row>
</form>
