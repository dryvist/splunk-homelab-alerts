<form version="1.1" theme="dark">
  <label>Homelab OpenBao signals</label>
  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="time" searchWhenChanged="true">
      <label>Time range</label>
      <default>
        <earliest>-24h</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="text" token="host" searchWhenChanged="true">
      <label>Host</label>
      <default>*</default>
    </input>
  </fieldset>
  <row>
    <panel>
      <chart>
        <title>Audit requests by host</title>
        <search>
          <query>index=openbao_audit host="$host$" | timechart span=1m count by host limit=10</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
        <title>Healthy Raft voters</title>
        <search>
          <query>index=openbao sourcetype="openbao:voter:health" host="$host$" | where health_state!="unreachable" AND health_state!="unknown" | timechart span=5m dc(voter) AS healthy_voters</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
      </chart>
    </panel>
  </row>
</form>
