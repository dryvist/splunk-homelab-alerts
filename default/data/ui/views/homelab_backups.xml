<form version="1.1" theme="dark">
  <label>Homelab backup signals</label>
  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="time" searchWhenChanged="true">
      <label>Time range</label>
      <default>
        <earliest>-24h</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="text" token="host" searchWhenChanged="true">
      <label>Host</label>
      <default>*</default>
    </input>
    <input type="text" token="unit" searchWhenChanged="true">
      <label>Unit</label>
      <default>*</default>
    </input>
  </fieldset>
  <row>
    <panel>
      <chart>
        <title>Backup unit outcomes</title>
        <search>
          <query>`homelab_os_log_indexes` `homelab_backup_units` host="$host$" ("Deactivated successfully" OR "Failed with result") | rex "(?&lt;unit&gt;[^\s:]+\.service): (?:Deactivated successfully|Failed with result)" | search unit="$unit$" | timechart span=30m count by unit limit=10</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
        <title>Backup task and status lines</title>
        <search>
          <query>`homelab_os_log_indexes` host="$host$" ("TASK OK" OR "TASK ERROR" OR "pbs-status") | timechart span=30m count</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
      </chart>
    </panel>
  </row>
</form>
